{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.technical-debt-engine.dev/evidence/1.0.0/schema.json",
  "title": "TDE evidence envelope",
  "type": "object",
  "required": ["schemaId", "schemaVersion", "runtime", "executionId", "repository", "candidate", "configurationDigest", "capabilityResults", "validation", "timestamps", "integrity"],
  "properties": {"schemaId": {"const": "tde.evidence"}, "schemaVersion": {"const": "1.0.0"}, "runtime": {"type": "object", "required": ["id", "version"], "properties": {"id": {"const": "tde"}, "version": {"type": "string"}}}, "executionId": {"type": "string"}, "repository": {"type": "object", "required": ["id", "displayName"], "properties": {"id": {"type": "string"}, "displayName": {"type": "string"}, "rootPath": {"type": "string"}, "remoteUrl": {"type": "string"}}}, "candidate": {"$ref": "domain.schema.json#/$defs/candidate"}, "configurationDigest": {"type": "string"}, "capabilityResults": {"type": "array", "items": {"$ref": "#/$defs/capabilityResult"}}, "measurements": {"type": "array", "items": {"$ref": "measurement.schema.json"}}, "findings": {"type": "array", "items": {"$ref": "finding.schema.json"}}, "validation": {"$ref": "validation.schema.json"}, "qualification": {"$ref": "qualification.schema.json"}, "limitations": {"type": "array", "items": {"$ref": "domain.schema.json#/$defs/limitation"}}, "timestamps": {"type": "object", "required": ["executedAt", "generatedAt"], "properties": {"executedAt": {"type": "string"}, "generatedAt": {"type": "string"}}}, "integrity": {"type": "object", "required": ["algorithm", "contentDigest"], "properties": {"algorithm": {"const": "sha-256"}, "contentDigest": {"type": "string"}}}},
  "$defs": {"capabilityResult": {"type": "object", "required": ["capabilityId", "capabilityVersion", "status", "completeness", "qualificationApplicable"], "properties": {"capabilityId": {"type": "string"}, "capabilityVersion": {"type": "string"}, "status": {"enum": ["VALID", "PARTIAL", "NOT_SUPPORTED", "NOT_CONFIGURED", "FAILED", "BLOCKED"]}, "adapterIds": {"type": "array", "items": {"type": "string"}}, "measurements": {"type": "array", "items": {"$ref": "measurement.schema.json"}}, "findings": {"type": "array", "items": {"$ref": "finding.schema.json"}}, "limitations": {"type": "array", "items": {"$ref": "domain.schema.json#/$defs/limitation"}}, "executionTiming": {"type": "object"}, "completeness": {"type": "number", "minimum": 0, "maximum": 1}, "qualificationApplicable": {"type": "boolean"}}}}
}
